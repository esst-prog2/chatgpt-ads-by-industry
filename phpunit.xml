<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Pinned, not left to whatever the real .env's APP_URL currently
             is (a tunnel URL, a LAN IP, localhost - it changes) - several
             tests assert on url()/route()-derived values (e.g. the Google
             OAuth redirect_uri, see GoogleAuthController::callbackUrl() and
             PLANNING_LOG.md 2026-11-02), and without this override those
             assertions would silently depend on whatever machine/moment the
             suite happens to run on, not a stable, known value. -->
        <env name="APP_URL" value="http://localhost"/>
        <!-- Same reasoning as APP_URL above, caught the hard way: this flag
             isn't normally set (see README.md "LAN access via a tunnel"),
             but a real .env can have it left on from testing the tunnel
             feature - without pinning it here, the suite would silently run
             every url()/route() assertion under forced https depending on
             whatever state a real .env happens to be in, exactly the
             hermeticity gap APP_URL already had. See PLANNING_LOG.md
             2026-11-07. -->
        <env name="FORCE_HTTPS_URLS" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
